 -- Template strings of random digits with 11-digit groups separated by dashes
 
 -- 10 groups, 119 characters
-local c_value_template = "###########-###########-###########-" ..
+local c_value_template_full = "###########-###########-###########-" ..
    "###########-###########-###########-" ..
    "###########-###########-###########-" ..
    "###########"
 
 -- 5 groups, 59 characters
-local pad_value_template = "###########-###########-###########-" ..
+local pad_value_template_full = "###########-###########-###########-" ..
    "###########-###########"
 
+-- Patch (sysbench-compressible, Percona-Lab, 2026-11-22): --data-random-pct keeps that share of each 11-digit group random ('#') and turns the
+-- rest of the group into fixed text. Positions are the same in every row, so lz4/zstd find long repeats across rows.
+local FILL = "the quick brown fox jumps over the lazy dog while the cat sleeps on a warm mat by the open door of the old house "
+local function shape(tpl)
+   local pct = tonumber(sysbench.opt.data_random_pct) or 100
+   if pct >= 100 then return tpl end
+   local keep = math.floor(11 * pct / 100 + 0.5)
+   local out, g, pos = {}, 0, 0
+   for i = 1, #tpl do
+      local ch = tpl:sub(i, i)
+      if ch == "#" then
+         pos = pos + 1
+         if pos <= keep then out[#out + 1] = "#" else out[#out + 1] = FILL:sub((i - 1) % #FILL + 1, (i - 1) % #FILL + 1) end
+      else
+         pos = 0
+         out[#out + 1] = ch
+      end
+   end
+   return table.concat(out)
+end
+-- templates are built on first use: options are parsed after this file is loaded
+local c_tpl, pad_tpl
+function c_value_template_get()
+   if not c_tpl then c_tpl = shape(c_value_template_full) end
+   return c_tpl
+end
+function pad_value_template_get()
+   if not pad_tpl then pad_tpl = shape(pad_value_template_full) end
+   return pad_tpl
+end
+
 function get_c_value()
-   return sysbench.rand.string(c_value_template)
+   return sysbench.rand.string(c_value_template_get())
 end
 
 function get_pad_value()
-   return sysbench.rand.string(pad_value_template)
+   return sysbench.rand.string(pad_value_template_get())
 end
 
